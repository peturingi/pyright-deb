#!/usr/bin/make -f

%:
	dh $@

# The JavaScript dependencies (node_modules) are installed with pnpm by
# mkosi.build.chroot before dpkg-buildpackage runs, as that needs network.
override_dh_auto_configure:
	test -d node_modules || { echo "node_modules missing: run pnpm install first" >&2; exit 1; }

override_dh_auto_build:
	pnpm --dir packages/pyright run build

# The upstream test suite (jest over pyright-internal) takes a long time;
# mkosi.postinst.chroot smoke-tests the installed package instead.
override_dh_auto_test:

override_dh_auto_install:

override_dh_auto_clean:
